# Send www.emharley.com to the bare domain so there's one address for search engines.
# Hostinger's CDN already redirects http to https, so this only checks the host.
# Checking %{HTTPS} here could loop, because the CDN talks to the server over http.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.emharley\.com$ [NC]
RewriteRule ^ https://emharley.com%{REQUEST_URI} [L,R=301]

# Make browsers and in-app browsers (X, LinkedIn) check back for fresh HTML on every
# visit, so a cached old page is never shown. Vite puts a hash in asset file names,
# so those can be cached for a year.
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
